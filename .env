# Local-only credentials for the MinIO container (fake S3). Nothing secret here.
AIRFLOW_CONN_AWS_DEFAULT=aws://minioadmin:minioadmin@/?endpoint_url=http%3A%2F%2Fminio%3A9000&region_name=us-east-1

# Two live bundles pointing at the SAME files, staged two different ways.
# The DAG processor logs the staging of each — compare them with `just logs`.
AIRFLOW__DAG_PROCESSOR__DAG_BUNDLE_CONFIG_LIST=[{"name": "s3-per-object", "classpath": "airflow.providers.amazon.aws.bundles.s3.S3DagBundle", "kwargs": {"bucket_name": "dag-bundles", "prefix": "dags/", "aws_conn_id": "aws_default"}}, {"name": "s3-archive", "classpath": "s3_archive_bundle.S3ArchiveDagBundle", "kwargs": {"bucket_name": "dag-bundles", "prefix": "dags/", "archive_key": "archive/dag-bundle.tar.gz", "aws_conn_id": "aws_default"}}]
