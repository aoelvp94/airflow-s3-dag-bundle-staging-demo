# Local-only credentials for the MinIO container (fake S3). Nothing secret here.
AIRFLOW_CONN_AWS_DEFAULT=aws://minioadmin:minioadmin@/?endpoint_url=http%3A%2F%2Fminio%3A9000&region_name=us-east-1

# Two live bundles, two classpaths, same bucket. The image overlays
# vendor/s3.py (apache/airflow 602dc7b, PR #73015) onto the Amazon provider,
# so both classes import from airflow.providers.amazon.aws.bundles.s3.
#   s3-per-object  S3DagBundle         kwargs: prefix
#   s3-archive     S3ArchiveDagBundle  kwargs: archive_key
# The archive ETag marker is {s3_dags_dir}/.archive_etag inside the staged tree.
AIRFLOW__DAG_PROCESSOR__DAG_BUNDLE_CONFIG_LIST=[{"name": "s3-per-object", "classpath": "airflow.providers.amazon.aws.bundles.s3.S3DagBundle", "kwargs": {"bucket_name": "dag-bundles", "prefix": "dags/", "aws_conn_id": "aws_default"}}, {"name": "s3-archive", "classpath": "airflow.providers.amazon.aws.bundles.s3.S3ArchiveDagBundle", "kwargs": {"bucket_name": "dag-bundles", "archive_key": "archive/dag-bundle.tar.gz", "aws_conn_id": "aws_default"}}]
